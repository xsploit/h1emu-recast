# Bounded bake fixture: seven large walkable patches plus a static obstacle
# embedded in terrain. The dynamic door triangle is deliberately excluded and
# exercises the required runtime-door acknowledgement.
o terrain_with_obstacle
v 0 0 0
v 8 0 0
v 8 0 8
v 0 0 8
usemtl nav_terrain
f 1 4 3
f 1 3 2

# Static obstacle cube within the terrain patch (x/z 2..6, y 0..2).
v 2 0 2
v 6 0 2
v 6 0 6
v 2 0 6
v 2 2 2
v 6 2 2
v 6 2 6
v 2 2 6
usemtl nav_obstacle_static
f 5 6 7
f 5 7 8
f 9 12 11
f 9 11 10
f 5 9 10
f 5 10 6
f 6 10 11
f 6 11 7
f 7 11 12
f 7 12 8
f 8 12 9
f 8 9 5

o road
v 10 0 0
v 18 0 0
v 18 0 8
v 10 0 8
usemtl nav_road
f 13 16 15
f 13 15 14

o floor_exterior
v 20 0 0
v 28 0 0
v 28 0 8
v 20 0 8
usemtl nav_floor_exterior
f 17 20 19
f 17 19 18

o floor_interior
v 30 0 0
v 38 0 0
v 38 0 8
v 30 0 8
usemtl nav_floor_interior
f 21 24 23
f 21 23 22

o stair
v 40 0 0
v 48 0 0
v 48 0 8
v 40 0 8
usemtl nav_stair
f 25 28 27
f 25 27 26

o ramp
v 50 0 0
v 58 0 0
v 58 0 8
v 50 0 8
usemtl nav_ramp
f 29 32 31
f 29 31 30

o threshold
v 60 0 0
v 68 0 0
v 68 0 8
v 60 0 8
usemtl nav_threshold
f 33 36 35
f 33 35 34

o dynamic_door_panel
v 70 0 0
v 70 2 0
v 70 0 2
usemtl nav_door_panel_dynamic
f 37 38 39
