# Only nav_floor_interior has walkable source coverage inside the requested
# bounds. The terrain is a whole source chunk outside the regional bake, while
# the in-bounds ramp face is vertical and cannot pass Recast's slope test.
o interior_floor
v 0 0 0
v 12 0 0
v 12 0 12
v 0 0 12
usemtl nav_floor_interior
f 1 4 3
f 1 3 2

o vertical_ramp_face
v 2 0 2
v 2 4 2
v 2 4 10
v 2 0 10
usemtl nav_ramp
f 5 6 7
f 5 7 8

o static_obstacle
v 4 0 4
v 6 0 4
v 6 0 6
v 4 0 6
v 4 2 4
v 6 2 4
v 6 2 6
v 4 2 6
usemtl nav_obstacle_static
f 9 10 11
f 9 11 12
f 13 16 15
f 13 15 14
f 9 13 14
f 9 14 10
f 10 14 15
f 10 15 11
f 11 15 16
f 11 16 12
f 12 16 13
f 12 13 9

o terrain_chunk_outside_region
v 100 0 100
v 112 0 100
v 112 0 112
v 100 0 112
usemtl nav_terrain
f 17 20 19
f 17 19 18
