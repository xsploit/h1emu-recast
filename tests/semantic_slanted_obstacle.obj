# A narrow diagonal wall and a walkable patch that lies inside the wall's
# axis-aligned bounding box, but does not intersect the wall itself. Semantic
# obstacle handling must follow rasterized geometry: an AABB post-carve would
# incorrectly erase the entire floor patch.
o interior_floor_off_wall
v 3 0 7
v 5 0 7
v 5 0 9
v 3 0 9
usemtl nav_floor_interior
f 1 4 3
f 1 3 2

o narrow_diagonal_wall
v 1.929 0 2.071
v 2.071 0 1.929
v 9.929 0 10.071
v 10.071 0 9.929
v 1.929 2 2.071
v 2.071 2 1.929
v 9.929 2 10.071
v 10.071 2 9.929
usemtl nav_obstacle_static
# bottom and top
f 5 6 7
f 6 8 7
f 9 11 10
f 10 11 12
# side faces
f 5 9 10
f 5 10 6
f 6 10 12
f 6 12 8
f 8 12 11
f 8 11 7
f 7 11 9
f 7 9 5
